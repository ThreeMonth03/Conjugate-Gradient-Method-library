FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/cg
ENV PIP_CACHE_DIR=/workspace/cg/.cache/pip \
    PYTHONUNBUFFERED=1 \
    CC=gcc \
    CXX=g++

COPY requirements/ requirements/
COPY contrib/docker/config/requirements.txt contrib/docker/config/requirements.txt
RUN python -m venv .venv \
    && .venv/bin/python -m pip install -r contrib/docker/config/requirements.txt

ARG CG_WITH_BENCHMARKS=0
RUN if [ "$CG_WITH_BENCHMARKS" = "1" ]; then \
        .venv/bin/python -m pip install -r requirements/benchmark.lock; \
    fi

COPY CMakeLists.txt CMakePresets.json Makefile pyproject.toml README.md .clang-format .clang-tidy ./
COPY cpp/matrix/*.cpp cpp/matrix/*.hpp cpp/matrix/
COPY cpp/cg_method/*.cpp cpp/cg_method/*.hpp cpp/cg_method/
COPY cpp/pybind/*.cpp cpp/pybind/
COPY include/cg/*.hpp include/cg/
COPY include/cg/detail/*.hpp include/cg/detail/
COPY cmake/*.cmake cmake/
COPY src/*.cpp src/
COPY bindings/*.cpp bindings/
COPY python/*.py python/
COPY python/cgpy/*.py python/cgpy/
COPY python/cgbench/*.py python/cgbench/
COPY python/README.md python/
COPY docs/*.md docs/
COPY docs/*.rst docs/conf.py docs/
COPY scripts/*.py scripts/
COPY tests/*.py tests/
COPY tests/cpp/*.cpp tests/cpp/
COPY demo/*.py demo/
COPY benchmarks/*.md benchmarks/
COPY benchmarks/results/ benchmarks/results/

CMD ["make", "test"]
