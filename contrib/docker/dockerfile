FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/cg
ENV PIP_CACHE_DIR=/workspace/cg/.cache/pip \
    PYTHONUNBUFFERED=1 \
    CC=gcc \
    CXX=g++

COPY requirements/ requirements/
COPY contrib/docker/config/requirements.txt contrib/docker/config/requirements.txt
RUN python -m venv .venv \
    && .venv/bin/python -m pip install -r contrib/docker/config/requirements.txt

ARG CG_WITH_BENCHMARKS=0
RUN if [ "$CG_WITH_BENCHMARKS" = "1" ]; then \
        .venv/bin/python -m pip install -r requirements/benchmark.lock; \
    fi

COPY CMakeLists.txt CMakePresets.json Makefile pyproject.toml README.md STYLE.md .clang-format .clang-tidy .python-version ./
COPY cpp/ cpp/
COPY cmake/ cmake/
COPY python/ python/
COPY docs/ docs/
COPY scripts/ scripts/
COPY tests/ tests/
COPY examples/ examples/

CMD ["make", "test"]
