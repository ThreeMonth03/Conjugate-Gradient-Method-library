@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
unset(cgpy_NOT_FOUND_MESSAGE)

# Dependencies may change PACKAGE_PREFIX_DIR with CMake older than 3.30.
set(_cgpy_prefix "${PACKAGE_PREFIX_DIR}")
set(_cgpy_libdir "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
find_dependency(Threads)
if(@CG_ENABLE_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()

if(@CG_ENABLE_BLAS@ AND NOT TARGET cg::private_blas)
    set_and_check(_cgpy_blas_archive "${_cgpy_libdir}/libcgpy_openblas.a")
    add_library(cg::private_blas STATIC IMPORTED)
    set_target_properties(cg::private_blas PROPERTIES
        IMPORTED_LOCATION "${_cgpy_blas_archive}"
        INTERFACE_LINK_LIBRARIES "Threads::Threads;m;${CMAKE_DL_LIBS}"
        INTERFACE_LINK_OPTIONS "LINKER:--exclude-libs,libcgpy_openblas.a"
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cgpyTargets.cmake")
set(cgpy_CUDA_FOUND FALSE)
foreach(_cgpy_component IN LISTS cgpy_FIND_COMPONENTS)
    if(NOT _cgpy_component STREQUAL "CUDA")
        set(cgpy_${_cgpy_component}_FOUND FALSE)
        string(APPEND cgpy_NOT_FOUND_MESSAGE "Unknown cgpy component: ${_cgpy_component}\n")
    elseif(NOT @CG_ENABLE_CUDA@ OR NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/cgpyCudaTargets.cmake")
        string(APPEND cgpy_NOT_FOUND_MESSAGE "The installed cgpy package was built without CUDA\n")
    else()
        if(cgpy_FIND_REQUIRED_CUDA)
            find_dependency(CUDAToolkit 12.8)
        else()
            find_package(CUDAToolkit 12.8 QUIET)
        endif()
        if(CUDAToolkit_FOUND AND CUDAToolkit_VERSION VERSION_LESS "13.0")
            include("${CMAKE_CURRENT_LIST_DIR}/cgpyCudaTargets.cmake")
            set(cgpy_CUDA_FOUND TRUE)
        else()
            string(APPEND cgpy_NOT_FOUND_MESSAGE "The cgpy CUDA component requires CUDA Toolkit >=12.8 and <13\n")
        endif()
    endif()
endforeach()

set(PACKAGE_PREFIX_DIR "${_cgpy_prefix}")
unset(_cgpy_prefix)
unset(_cgpy_libdir)
unset(_cgpy_blas_archive)
unset(_cgpy_component)
check_required_components(cgpy)
