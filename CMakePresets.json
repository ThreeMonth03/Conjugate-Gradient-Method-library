{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CG_ENABLE_OPENMP": "OFF",
        "CG_ENABLE_BLAS": "OFF",
        "BUILD_TESTING": "ON",
        "CG_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "cpu-debug",
      "inherits": "cpu-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "cpu-openmp",
      "inherits": "cpu-release",
      "cacheVariables": {
        "CG_ENABLE_OPENMP": "ON"
      }
    },
    {
      "name": "cpu-blas",
      "inherits": "cpu-release",
      "cacheVariables": {
        "CG_ENABLE_BLAS": "ON"
      }
    },
    {
      "name": "cpu-asan",
      "inherits": "cpu-debug",
      "cacheVariables": {
        "CG_BUILD_PYTHON": "OFF",
        "CG_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "cuda-release",
      "inherits": "cpu-release",
      "cacheVariables": {
        "CG_ENABLE_CUDA": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/CGCudaToolchain.cmake"
      }
    }
  ]
}
